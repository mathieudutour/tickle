# Files in /assets have a content hash in their name: a new version gets a new name, so they never need re-checking.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Read by iOS to open invitation links in the app (ios/Tickle/App/Router.swift).
/.well-known/apple-app-site-association
  Content-Type: application/json
